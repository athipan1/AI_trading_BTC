EXCHANGE_ID=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h
MARKET_DATA_LIMIT=250
TRADING_MODE=paper
STARTING_BALANCE=10000
RISK_PER_TRADE_PCT=0.005
MAX_POSITION_NOTIONAL_PCT=0.25
MIN_REWARD_RISK=1.5
FEE_RATE=0.001
SLIPPAGE_BPS=5

# Binance Spot Testnet only. Never put real keys in this file.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_MAX_NOTIONAL_USDT=25
BINANCE_TESTNET_MAX_EXIT_NOTIONAL_USDT=100

# Binance USD-M Futures Testnet / demo. Keep these separate from Spot keys.
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=
BINANCE_FUTURES_TESTNET_MAX_NOTIONAL_USDT=100
BTC_FUTURES_SHORT_ENTRY_NOTIONAL_USDT=55
BTC_FUTURES_SHORT_CANDLE_LIMIT=240
BTC_FUTURES_SHORT_INTERVAL_SECONDS=30
BTC_FUTURES_SHORT_REQUIRE_LINE=true

# Manual Testnet order TP/SL alert thresholds.
BTC_TESTNET_TP_PCT=2
BTC_TESTNET_SL_PCT=1

# Automatic Binance Spot Testnet loop.
# Entry is still capped again by RiskEngine and BINANCE_TESTNET_MAX_NOTIONAL_USDT.
BTC_TESTNET_AUTO_ENTRY_NOTIONAL_USDT=10
BTC_TESTNET_AUTO_CANDLE_LIMIT=240
BTC_TESTNET_AUTO_INTERVAL_SECONDS=30
BTC_TESTNET_AUTO_REQUIRE_LINE=true
BTC_TESTNET_MONITOR_INTERVAL_SECONDS=30

# Phase 4.1 isolated validation trade. Disabled by default.
# Uses Binance Spot Testnet only and a separate validation PositionStore.
PHASE41_VALIDATION_TRADE_ENABLED=false
PHASE41_VALIDATION_POSITION_STORE=state/phase41-validation-positions.json
PHASE41_VALIDATION_NOTIONAL_USDT=10

# LINE Messaging API. Keep both values secret and out of Git.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
